# ==============================================================================
# .dockerignore — Prevent bloated or sensitive files in container build context
# ==============================================================================

.git
.gitignore
.dockerignore
__pycache__
*.py[cod]
*$py.class
.venv/
venv/
env/

# Runtime and temporary artifacts
output/*.log
output/*.tmp
output/server_debug.log
reports/full_data_cleaned.csv
data/uploaded_dataset*
data/temp_*

# Local scratch and test scripts
scratch/
scratch_*
create_multisheet.R
custom_test_upload*

# OS and Editor configs
.DS_Store
Thumbs.db
.vscode/
.idea/
.env*
